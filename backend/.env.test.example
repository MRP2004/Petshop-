PORT=0
FRONTEND_URL=http://localhost:5173

# Base de datos EXCLUSIVA para pruebas de integración. Nunca debe apuntar a
# la misma base que .env (desarrollo), y el nombre debe coincidir EXACTO
# con el que espera test-integracion/ayudaIntegracion.js (por defecto,
# "petshop_test"; configurable con INTEGRACION_DB_NAME_PERMITIDA).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=petshop_test

# Usuario EXCLUSIVO para la base de pruebas, con privilegios limitados a
# esa única base (más SELECT sobre performance_schema, para las pruebas de
# concurrencia). No reutilizar petshop_app: ese usuario puede tener acceso
# a la base de desarrollo, y este archivo puede terminar compartiéndose o
# quedando en un entorno donde no conviene que alcance más que la base de
# pruebas. Ver docs/backend-base-de-datos.md para el SQL exacto que crea
# este usuario y sus permisos.
DB_USER=petshop_test_app
DB_PASSWORD=

# Habilitación explícita: sin esto en "si", ayudaIntegracion.js se niega a
# limpiar datos, incluso si DB_NAME es correcto.
PERMITIR_LIMPIEZA_INTEGRACION=si

# Clave de firma de JWT para las pruebas de integración (no reutilizar la de
# desarrollo ni la de producción).
JWT_SECRET=clave-de-prueba-no-usar-en-produccion-0000000000
