PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=petshop_db
DB_USER=petshop_app
DB_PASSWORD=

# Clave de firma de los tokens de sesión (JWT). Generarla, por ejemplo, con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# No reutilizar el mismo valor entre ambientes ni subir el valor real a git.
JWT_SECRET=

# Correo del comprobante de compra (CU-04, ver src/services/correo.service.js).
# Sin SMTP_HOST configurado (como acá, por defecto), se usa un transporte de
# prueba que arma el mensaje en memoria y no manda nada real — el checkout
# sigue funcionando igual, solo que la entrega real queda sin verificar.
# Completar estas variables para probar el envío real en desarrollo local:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CORREO_REMITENTE=no-responder@petshop.demo
# CORREO_TRANSPORTE=prueba fuerza el transporte de prueba aunque haya
# SMTP_HOST configurado (usado en .env.test/.env.e2e: "no enviar correos
# reales durante las pruebas"). Dejar vacío en desarrollo si se quiere
# probar el envío real.
CORREO_TRANSPORTE=

# URL PÚBLICA del frontend (corrección — revisión de Mauro tras la venta
# #20), SOLO para el enlace opcional dentro del correo del comprobante — no
# confundir con FRONTEND_URL de arriba, que es para CORS y siempre apunta a
# localhost en desarrollo/pruebas. Dejar VACÍO en desarrollo/pruebas: sin
# esta variable, el correo simplemente omite el enlace (el resumen + el PDF
# adjunto ya alcanzan por sí solos) en vez de mandar un enlace a localhost,
# que nadie fuera de esta máquina podría abrir. Completar SOLO si el
# frontend está desplegado en una URL pública real, por ejemplo:
#   URL_PUBLICA_FRONTEND=https://petshop.ejemplo.com
URL_PUBLICA_FRONTEND=