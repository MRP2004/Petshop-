# Configuración AISLADA para levantar una segunda instancia del backend
# dedicada a las pruebas E2E (Playwright, ver docs/frontend-pruebas.md,
# sección "Aislamiento para E2E"), sin escribir sobre la base de desarrollo
# (petshop_db) ni sobre la de integración (petshop_test) — las tres deben
# ser bases distintas: la de integración se limpia con DELETE de punta a
# punta entre corridas, y pisaría los datos de demostración que necesita
# E2E; y viceversa, E2E deja filas persistentes (una venta de ejemplo, un
# usuario) que romperían las aserciones de "estado inicial vacío" de
# integración si compartieran base.
#
# Copiar a .env.e2e (nunca versionado, ver .gitignore) y completar la
# contraseña. Requiere la base y el usuario ya creados por un administrador
# (ver docs/backend-base-de-datos.md, "Base aislada para E2E", con
# DB_TEST_NAME=petshop_e2e / DB_TEST_USER=petshop_e2e_app).
#
# Puerto distinto (3001) para poder correr esta instancia AL MISMO TIEMPO
# que el backend de desarrollo (puerto 3000, .env normal), sin que se pisen.
# server.js aborta si el puerto ya está en uso, en vez de arrancar en otro
# puerto en silencio (ver docs/frontend-pruebas.md).
PORT=3001

# Frontend EXCLUSIVO de E2E, puerto distinto del de desarrollo (5173) — ver
# frontend/.env.e2e.example. Necesario para que CORS acepte los pedidos con
# cookies de ese frontend (credentials:true exige un origin explícito).
FRONTEND_URL=http://localhost:5183

DB_HOST=localhost
DB_PORT=3306
DB_NAME=petshop_e2e

# Usuario EXCLUSIVO para la base de E2E, con privilegios limitados a esa
# única base (no reutilizar petshop_app ni petshop_test_app).
DB_USER=petshop_e2e_app
DB_PASSWORD=

# Clave de firma de JWT para esta instancia (no reutilizar la de desarrollo,
# la de integración ni la de producción).
JWT_SECRET=clave-de-prueba-e2e-no-usar-en-produccion-0000000000

# Nombre de entorno: además de identificar esta instancia en /api/health
# (ver src/app.js), le agrega un sufijo a las cookies de sesión/CSRF (ver
# utils/sesion.js) para que no puedan colisionar con las de desarrollo —
# los puertos distintos por sí solos NO separan cookies entre sí (el
# navegador comparte el mismo frasco de cookies entre puertos del mismo
# host). No se debe cambiar ni quitar.
ENTORNO=e2e

# Habilitación explícita para scripts/sembrarDatosE2E.js (npm run
# sembrar:e2e): ese script BORRA todo lo que haya en petshop_e2e antes de
# volver a sembrar (para que cada corrida de Playwright parta del mismo
# estado conocido, ver docs/frontend-pruebas.md). Sin esto en "si", se
# niega a tocar nada, incluso si DB_NAME es correcto.
PERMITIR_SEMBRADO_E2E=si

# Límite de intentos de login (ver src/routes/usuario.routes.js), más alto
# SOLO acá: Playwright corre en serie, sin reiniciar este backend, contra
# 2 cuentas fijas para 3 viewports — eso implica, de forma legítima, más
# de 8 intentos de login para la misma cuenta en 15 minutos, aunque no sea
# ningún ataque real. El límite de desarrollo/producción (8) no cambia.
LIMITE_LOGIN=200
LIMITE_LOGIN_POR_IP=500

# Correo del comprobante (CU-04): transporte de prueba, no manda nada real
# (ver src/services/correo.service.js) — E2E tampoco debe enviar correos
# reales.
CORREO_TRANSPORTE=prueba

# Deliberadamente vacío: sin URL pública, el correo (de prueba, acá) omite
# el enlace en vez de armar uno con FRONTEND_URL (que es localhost:5183).
URL_PUBLICA_FRONTEND=

# Techo de registros por IP (ver src/routes/usuario.routes.js), más alto
# SOLO acá: el E2E del vendedor independiente registra una cuenta nueva por
# viewport y por corrida. El valor de desarrollo/producción (15) no cambia.
LIMITE_REGISTRO_POR_IP=500
