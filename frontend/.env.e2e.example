# Configuración para correr el frontend contra el backend AISLADO de E2E
# (puerto 3001, ver backend/.env.e2e.example), no contra el de desarrollo.
# No lleva ningún secreto. Copiar a .env.e2e (no versionado) si hace falta
# cambiar algún valor; el que está acá ya es el correcto para correr todo
# en la misma máquina.
VITE_API_URL=http://localhost:3001/api

# Debe coincidir EXACTO con `ENTORNO` de backend/.env.e2e ("e2e"): el
# backend le agrega este sufijo al nombre de su cookie de CSRF
# (ver backend/src/utils/sesion.js), y httpClient.js necesita buscarla con
# el mismo nombre para poder mandarla de vuelta como header
# `X-CSRF-Token` — si no coinciden, cualquier POST/PUT/PATCH/DELETE contra
# el backend E2E responde 403 "Token CSRF inválido o ausente".
VITE_ENTORNO=e2e
